{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "mentoring-adf-jk"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/DF_PopulateDataMart')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "MoviesServies",
								"type": "DatasetReference"
							},
							"name": "sourceMoviesService"
						},
						{
							"dataset": {
								"referenceName": "moviesMovies",
								"type": "DatasetReference"
							},
							"name": "sourceMovies"
						},
						{
							"dataset": {
								"referenceName": "MoviesStatus",
								"type": "DatasetReference"
							},
							"name": "sourceMoviesStatus"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DataMartService",
								"type": "DatasetReference"
							},
							"name": "sinkDataMartService"
						},
						{
							"dataset": {
								"referenceName": "DataMart",
								"type": "DatasetReference"
							},
							"name": "SinkDataMartMovies"
						}
					],
					"transformations": [
						{
							"name": "DatetimeService"
						},
						{
							"name": "DatetimeMovies"
						},
						{
							"name": "joinMoviesStatus"
						}
					],
					"scriptLines": [
						"parameters{",
						"     DatetimeNow as string",
						"}",
						"source(output(",
						"          ServiceId as integer,",
						"          ServiceCode as string,",
						"          ServiceName as string,",
						"          CreatedDate as timestamp,",
						"          ModifiedDate as timestamp",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> sourceMoviesService",
						"source(output(",
						"          MovieId as integer,",
						"          MovieIdNK as integer,",
						"          Budget as integer,",
						"          HomepagePath as string,",
						"          Title as string,",
						"          OriginalTitle as string,",
						"          ReleaseDate as date,",
						"          Revenue as long,",
						"          Runtime as integer,",
						"          MovieStatusId as integer,",
						"          AvgVote as decimal(3,1),",
						"          CreatedDate as timestamp,",
						"          ModifiedDate as timestamp,",
						"          SrcFileName as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> sourceMovies",
						"source(output(",
						"          MovieStatusId as integer,",
						"          MovieStatusName as string,",
						"          CreatedDate as timestamp",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> sourceMoviesStatus",
						"sourceMoviesService derive(CreatedDate = toTimestamp(\r",
						"$DatetimeNow\r",
						"),",
						"          ModifiedDate = toTimestamp($DatetimeNow)) ~> DatetimeService",
						"sourceMovies derive(CreatedDate = toTimestamp($DatetimeNow),",
						"          ModifiedDate = toTimestamp($DatetimeNow)) ~> DatetimeMovies",
						"DatetimeMovies, sourceMoviesStatus join(sourceMovies@MovieStatusId == sourceMoviesStatus@MovieStatusId,",
						"     joinType:'left',",
						"     matchType:'exact',",
						"     ignoreSpaces: false,",
						"     broadcast: 'auto')~> joinMoviesStatus",
						"DatetimeService sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          ServiceKey as integer,",
						"          ServiceCode as string,",
						"          ServiceName as string,",
						"          CreatedDate as timestamp,",
						"          ModifiedDate as timestamp",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     truncate:true,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> sinkDataMartService",
						"joinMoviesStatus sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          MovieKey as integer,",
						"          MovieIdNK as integer,",
						"          Title as string,",
						"          ReleaseDate as date,",
						"          Runtime as integer,",
						"          MovieStatus as string,",
						"          CreatedDate as timestamp,",
						"          ModifiedDate as timestamp",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     truncate:true,",
						"     format: 'table',",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          MovieIdNK,",
						"          Title,",
						"          ReleaseDate,",
						"          Runtime,",
						"          MovieStatus = MovieStatusName,",
						"          CreatedDate = DatetimeMovies@CreatedDate,",
						"          ModifiedDate",
						"     )) ~> SinkDataMartMovies"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/DF_PopulateFact')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_ASQL_tOnlinePurchaise",
								"type": "DatasetReference"
							},
							"name": "SourceFactOnlinePurchase"
						},
						{
							"dataset": {
								"referenceName": "DataMart",
								"type": "DatasetReference"
							},
							"name": "SourceMovies"
						},
						{
							"dataset": {
								"referenceName": "DataMartService",
								"type": "DatasetReference"
							},
							"name": "SourceOnlineService"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DataMartFactOnlinePurchase",
								"type": "DatasetReference"
							},
							"name": "SinkOnlinePurchase"
						},
						{
							"dataset": {
								"referenceName": "OnlinePurchaiseSnap",
								"type": "DatasetReference"
							},
							"name": "SinlOPSnap"
						}
					],
					"transformations": [
						{
							"name": "JoinOnlineService"
						},
						{
							"name": "JoinMovies"
						},
						{
							"name": "AggPurchase"
						},
						{
							"name": "derivedColumn1"
						},
						{
							"name": "derivedColumn2"
						}
					],
					"scriptLines": [
						"source(output(",
						"          Id as integer,",
						"          ServiceId as integer,",
						"          MovieId as integer,",
						"          UserId as integer,",
						"          Price as decimal(4,1),",
						"          TransactionId as string,",
						"          TransactionDate as string,",
						"          CreatedDate as timestamp,",
						"          ModifiedDate as timestamp,",
						"          SrcFileName as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> SourceFactOnlinePurchase",
						"source(output(",
						"          MovieKey as integer,",
						"          MovieIdNK as integer,",
						"          Title as string,",
						"          ReleaseDate as date,",
						"          Runtime as integer,",
						"          MovieStatus as string,",
						"          CreatedDate as timestamp,",
						"          ModifiedDate as timestamp,",
						"          MovieId as integer",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> SourceMovies",
						"source(output(",
						"          ServiceKey as integer,",
						"          ServiceCode as string,",
						"          ServiceName as string,",
						"          CreatedDate as timestamp,",
						"          ModifiedDate as timestamp,",
						"          ServiceId as integer",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> SourceOnlineService",
						"SourceFactOnlinePurchase, SourceOnlineService join(SourceFactOnlinePurchase@ServiceId == SourceOnlineService@ServiceId,",
						"     joinType:'left',",
						"     matchType:'exact',",
						"     ignoreSpaces: false,",
						"     broadcast: 'auto')~> JoinOnlineService",
						"JoinOnlineService, SourceMovies join(SourceFactOnlinePurchase@MovieId == MovieIdNK,",
						"     joinType:'left',",
						"     matchType:'exact',",
						"     ignoreSpaces: false,",
						"     broadcast: 'auto')~> JoinMovies",
						"derivedColumn2 aggregate(groupBy(TransactionDate,",
						"          SourceFactOnlinePurchase@ServiceId),",
						"     PurchaseAmount = sum(Price),",
						"          PurchaseQuantity = count(TransactionId)) ~> AggPurchase",
						"JoinMovies derive(TransactionDate = toDate(TransactionDate)) ~> derivedColumn1",
						"JoinOnlineService derive(TransactionDate = replace(substringIndex(TransactionDate, '-', 2), '-', '')) ~> derivedColumn2",
						"derivedColumn1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          DateKey as integer,",
						"          OnlineServiceKey as integer,",
						"          MovieKey as integer,",
						"          Price as decimal(4,1),",
						"          TransactionId as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          DateKey = TransactionDate,",
						"          OnlineServiceKey = SourceFactOnlinePurchase@ServiceId,",
						"          MovieKey = SourceFactOnlinePurchase@MovieId,",
						"          Price,",
						"          TransactionId",
						"     )) ~> SinkOnlinePurchase",
						"AggPurchase sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          MonthKey as integer,",
						"          OnlineServiceKey as integer,",
						"          PurchaseAmount as decimal(10,1),",
						"          PurchaseQuantity as integer",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          MonthKey = TransactionDate,",
						"          OnlineServiceKey = ServiceId,",
						"          PurchaseAmount,",
						"          PurchaseQuantity",
						"     )) ~> SinlOPSnap"
					]
				}
			},
			"dependsOn": []
		},
