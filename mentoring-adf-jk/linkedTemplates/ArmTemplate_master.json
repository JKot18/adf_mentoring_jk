{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "mentoring-adf-jk"
		},
		"LS_BLOB_AZUREMENTORINGAU_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'LS_BLOB_AZUREMENTORINGAU'"
		},
		"LS_ASQL_DATAMART_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "azure-mentoring-jk.database.windows.net"
		},
		"LS_ASQL_DATAMART_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "DataMart"
		},
		"LS_ASQL_DATAMART_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "etl"
		},
		"LS_ASQL_MOVIES_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "tcp:azure-mentoring-jk.database.windows.net,1433"
		},
		"LS_ASQL_MOVIES_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "movies"
		},
		"LS_ASQL_MOVIES_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "etl"
		},
		"LS_BLOB_AZUREMENTORINGSTORAGEJK_properties_typeProperties_sasUri_secretName": {
			"type": "string",
			"defaultValue": "secret-blob-azurementoringstoragejk"
		},
		"LS_BLOB_AZUREMENTORING_ONLINE_properties_typeProperties_sasUri_secretName": {
			"type": "string",
			"defaultValue": "secret-blob-azurementoringstorage-online"
		},
		"LS_GEN2_AZUREMENTORINGDATALAKEJK_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://azurementoringdatalakejk.dfs.core.windows.net/"
		},
		"LS_KEYVAULT_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://azure-mentoring-jk.vault.azure.net/"
		},
		"LS_MSSQL_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "EPCZPRAW0123"
		},
		"LS_MSSQL_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "CinemaTickets"
		},
		"LS_MSSQL_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "stg"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "mentoring-adf-jk_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_BLOB_AZUREMENTORINGAU_connectionString": {
						"value": "[parameters('LS_BLOB_AZUREMENTORINGAU_connectionString')]"
					},
					"LS_GEN2_AZUREMENTORINGDATALAKEJK_properties_typeProperties_url": {
						"value": "[parameters('LS_GEN2_AZUREMENTORINGDATALAKEJK_properties_typeProperties_url')]"
					},
					"LS_KEYVAULT_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_KEYVAULT_properties_typeProperties_baseUrl')]"
					},
					"LS_ASQL_DATAMART_properties_typeProperties_server": {
						"value": "[parameters('LS_ASQL_DATAMART_properties_typeProperties_server')]"
					},
					"LS_ASQL_DATAMART_properties_typeProperties_database": {
						"value": "[parameters('LS_ASQL_DATAMART_properties_typeProperties_database')]"
					},
					"LS_ASQL_DATAMART_properties_typeProperties_userName": {
						"value": "[parameters('LS_ASQL_DATAMART_properties_typeProperties_userName')]"
					},
					"LS_ASQL_MOVIES_properties_typeProperties_server": {
						"value": "[parameters('LS_ASQL_MOVIES_properties_typeProperties_server')]"
					},
					"LS_ASQL_MOVIES_properties_typeProperties_database": {
						"value": "[parameters('LS_ASQL_MOVIES_properties_typeProperties_database')]"
					},
					"LS_ASQL_MOVIES_properties_typeProperties_userName": {
						"value": "[parameters('LS_ASQL_MOVIES_properties_typeProperties_userName')]"
					},
					"LS_BLOB_AZUREMENTORINGSTORAGEJK_properties_typeProperties_sasUri_secretName": {
						"value": "[parameters('LS_BLOB_AZUREMENTORINGSTORAGEJK_properties_typeProperties_sasUri_secretName')]"
					},
					"LS_BLOB_AZUREMENTORING_ONLINE_properties_typeProperties_sasUri_secretName": {
						"value": "[parameters('LS_BLOB_AZUREMENTORING_ONLINE_properties_typeProperties_sasUri_secretName')]"
					},
					"LS_MSSQL_properties_typeProperties_server": {
						"value": "[parameters('LS_MSSQL_properties_typeProperties_server')]"
					},
					"LS_MSSQL_properties_typeProperties_database": {
						"value": "[parameters('LS_MSSQL_properties_typeProperties_database')]"
					},
					"LS_MSSQL_properties_typeProperties_userName": {
						"value": "[parameters('LS_MSSQL_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "mentoring-adf-jk_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'mentoring-adf-jk_ArmTemplate_0')]"
			]
		},
		{
			"name": "mentoring-adf-jk_ArmTemplate_2",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_2.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'mentoring-adf-jk_ArmTemplate_1')]"
			]
		}
	]
}